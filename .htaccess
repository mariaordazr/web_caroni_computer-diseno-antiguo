<IfModule mod_rewrite.c>
    RewriteEngine On
    # 1. Esto arregla la pantalla negra (oculta la lista de archivos)
    Options -Indexes

    # 2. Si alguien entra a la raíz (el dominio solo), enviarlo al index de public
    RewriteRule ^$ public/index.php [L]

    # 3. IMÁGENES Y ESTILOS: 
    # Si el archivo que piden EXISTE realmente dentro de "public" (ej: logo.png), 
    # entonces muéstralo directamente desde ahí.
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
    RewriteRule ^(.*)$ public/$1 [L]

    # 4. RUTAS VIRTUALES (El arreglo del 404):
    # Si lo que piden NO es la carpeta "public" y no es un archivo real,
    # envíalo a "public/index.php" para que tu PHP muestre la página correcta.
    RewriteRule ^((?!public/).*)$ public/index.php [L,NC]
</IfModule>

# Mantén la compresión para velocidad (esto no rompía nada)
